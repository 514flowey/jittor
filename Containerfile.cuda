# Podman/Docker build for this local Jittor checkout, CUDA-enabled.
#
# This installs the project FROM THIS SOURCE TREE, not a published package.
# Two distributions live in this repo -- core (`jittor`, pyproject.toml at the
# repo root) and compat (`jittor-torch`, pyproject.toml under compat/) -- and
# both get installed, plus the pytest tooling tools/run_test_suite.py needs.
#
# Build (from repo root):
#   podman build -t jittor-cuda:local -f Containerfile.cuda .
#
# Run with GPU access (CDI device, see README/setup notes):
#   podman run --rm -it --device nvidia.com/gpu=all jittor-cuda:local bash

ARG FROM_IMAGE=nvidia/cuda:11.8.0-cudnn8-devel-ubuntu22.04
FROM ${FROM_IMAGE}

ENV PYTHONIOENCODING=utf8 \
    DEBIAN_FRONTEND=noninteractive \
    nvcc_path=/usr/local/cuda/bin/nvcc

RUN apt-get update && apt-get install -y --no-install-recommends \
        python3 python3-dev python3-pip \
        g++ build-essential libomp-dev \
        openmpi-bin openmpi-common libopenmpi-dev \
        ca-certificates git \
    && rm -rf /var/lib/apt/lists/*

RUN python3 -m pip install --no-cache-dir --upgrade pip && \
    python3 -m pip install --no-cache-dir numpy tqdm pillow astunparse \
        pytest==7.4.4 pytest-timeout==2.3.1 pytest-xdist==3.6.1 PyYAML==6.0.2 scipy==1.13.1

WORKDIR /usr/src/jittor
COPY . .

# Core: editable install so `tests/` (which import against the checkout) and
# tools/run_test_suite.py see the same tree that's mounted/copied in.
RUN python3 -m pip install --no-cache-dir --no-build-isolation -e .

# Compat ("jittor-torch"): independent distribution sharing the jittor.compat
# namespace. --no-deps because it declares jittor==1.3.11.0 as a dependency and
# we already installed core from source; --no-build-isolation so it reuses the
# already-installed setuptools/wheel instead of fetching build deps offline.
RUN python3 -m pip install --no-cache-dir --no-deps --no-build-isolation -e compat

CMD ["bash"]
